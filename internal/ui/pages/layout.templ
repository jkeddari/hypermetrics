package pages

import (
	"encoding/json"
	"fmt"
	"strings"
	"time"

	"github.com/jkeddari/hypermetrics/components/button"
)

type SEO struct {
	Title          string
	Description    string
	CanonicalURL   string
	ImageURL       string
	NoIndex        bool
	StructuredData string
}

func publicSEO(title string, description string, siteURL string, path string) SEO {
	baseURL := strings.TrimRight(siteURL, "/")
	return SEO{
		Title:        title,
		Description:  description,
		CanonicalURL: baseURL + path,
		ImageURL:     baseURL + "/assets/images/og-hypermetrics.png",
	}
}

func homeSEO(siteURL string) SEO {
	meta := publicSEO(
		"Real-time Hyperliquid market intelligence · Hypermetrics",
		"Real-time Hyperliquid market intelligence for traders, bot builders, and product teams.",
		siteURL,
		"/",
	)
	baseURL := strings.TrimRight(siteURL, "/")
	data, _ := json.Marshal(map[string]any{
		"@context": "https://schema.org",
		"@graph": []map[string]any{
			{
				"@type":        "WebSite",
				"name":         "Hypermetrics",
				"alternateName": "hypermetrics.xyz",
				"url":          baseURL + "/",
			},
			{
				"@type":       "Organization",
				"name":        "Hypermetrics",
				"url":         baseURL + "/",
				"description": "Real-time Hyperliquid market intelligence for traders, bot builders, and product teams.",
				"logo":        baseURL + "/assets/images/logo-512.png",
				"email":       "hello@hypermetrics.xyz",
			},
		},
	})
	meta.StructuredData = string(data)
	return meta
}

templ seoHead(meta SEO) {
	<meta name="description" content={ meta.Description }/>
	<title>{ meta.Title }</title>
	<link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg"/>
	<link rel="apple-touch-icon" sizes="180x180" href="/assets/images/apple-touch-icon.png"/>
	if meta.NoIndex {
		<meta name="robots" content="noindex, nofollow"/>
	}
	if meta.CanonicalURL != "" {
		<link rel="canonical" href={ meta.CanonicalURL }/>
		<meta property="og:type" content="website"/>
		<meta property="og:site_name" content="Hypermetrics"/>
		<meta property="og:title" content={ meta.Title }/>
		<meta property="og:description" content={ meta.Description }/>
		<meta property="og:url" content={ meta.CanonicalURL }/>
		<meta property="og:image" content={ meta.ImageURL }/>
		<meta property="og:image:width" content="1200"/>
		<meta property="og:image:height" content="630"/>
		<meta name="twitter:card" content="summary_large_image"/>
		<meta name="twitter:title" content={ meta.Title }/>
		<meta name="twitter:description" content={ meta.Description }/>
		<meta name="twitter:image" content={ meta.ImageURL }/>
	}
	if meta.StructuredData != "" {
		@templ.Raw(`<script type="application/ld+json">` + meta.StructuredData + `</script>`)
	}
}

templ base(meta SEO, loggedIn bool) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			@seoHead(meta)
			<link rel="stylesheet" href="/assets/css/output.css"/>
			<script src="/assets/js/theme.js"></script>
		</head>
		<body class="min-h-screen bg-background text-foreground antialiased">
			@publicNav(loggedIn)
			<main>
				{ children... }
			</main>
			@footer()
		</body>
	</html>
}

templ publicNav(loggedIn bool) {
	<header class="sticky top-0 z-50 border-b bg-background/90 backdrop-blur">
		<div class="container mx-auto flex h-16 max-w-7xl items-center justify-between px-4">
			<a href="/" class="flex items-center gap-2 font-bold tracking-tight">
				<span class="flex size-8 items-center justify-center rounded-lg bg-primary text-primary-foreground">H</span>
				Hypermetrics
			</a>
			<nav class="hidden items-center gap-6 text-sm md:flex" aria-label="Main navigation">
				<a href="/#product" class="text-muted-foreground transition-colors hover:text-foreground">Product</a>
				<a href="/docs" class="text-muted-foreground transition-colors hover:text-foreground">Documentation</a>
				<a href="/#pricing" class="text-muted-foreground transition-colors hover:text-foreground">Pricing</a>
				<a href="/#faq" class="text-muted-foreground transition-colors hover:text-foreground">FAQ</a>
				<a href="mailto:contact@hypermetrics.xyz" class="text-muted-foreground transition-colors hover:text-foreground">Contact</a>
			</nav>
			<div class="flex items-center gap-2">
				@themeToggle()
				if loggedIn {
					@button.Button(button.Props{Href: "/app/dashboard", Size: button.SizeSm}) {
						Dashboard
					}
				} else {
					@button.Button(button.Props{Href: "/login", Size: button.SizeSm}) {
						Sign in
					}
				}
			</div>
		</div>
	</header>
}

templ footer() {
	<footer class="border-t py-10">
		<div class="container mx-auto flex max-w-7xl flex-col gap-4 px-4 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
			<p>© { fmt.Sprintf("%d", time.Now().Year()) } Hypermetrics. Market intelligence at API speed.</p>
			<div class="flex flex-wrap gap-x-5 gap-y-2">
				<a href="/#pricing" class="hover:text-foreground">Pricing</a>
				<a href="/docs" class="hover:text-foreground">Documentation</a>
				<a href="/legal/privacy" class="hover:text-foreground">Privacy Policy</a>
				<a href="/legal/terms" class="hover:text-foreground">Terms</a>
				<a href="/login" class="hover:text-foreground">Account</a>
			</div>
		</div>
	</footer>
}

templ formError(message string) {
	<div role="alert" class="mb-5 rounded-md border border-destructive/30 bg-destructive/10 px-4 py-3 text-sm text-destructive">{ message }</div>
}

func planName(planID string) string {
	if planID == "pro" {
		return "Pro"
	}
	return "Builder"
}
