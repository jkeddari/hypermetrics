package pages

import "github.com/jkeddari/hypermetrics/components/button"

templ NotFound(loggedIn bool) {
	@base(SEO{
		Title: "Page not found · Hypermetrics",
		Description: "The requested Hypermetrics page does not exist.",
		NoIndex: true,
	}, loggedIn) {
		<section class="flex min-h-[65vh] items-center justify-center px-4 text-center">
			<div>
				<p class="text-sm font-semibold text-primary">404</p>
				<h1 class="mt-3 text-4xl font-bold">Page not found</h1>
				<p class="mt-3 text-muted-foreground">The page you requested does not exist.</p>
				<div class="mt-7">
					@button.Button(button.Props{Href: "/"}) {
						Back home 
					}
				</div>
			</div>
		</section>
	}
}
