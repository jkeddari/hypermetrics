package pages

templ Docs(siteURL string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			@seoHead(publicSEO(
				"Hypermetrics API Reference",
				"Hypermetrics API documentation for Hyperliquid whale alerts, wallet positions, market structure, authentication, and rate limits.",
				siteURL,
				"/docs",
			))
			<script src="/assets/js/theme.js"></script>
			<style>
				.docs-controls {
					position: fixed;
					top: 0.75rem;
					right: 1rem;
					z-index: 100;
					display: flex;
					gap: 0.5rem;
				}
				.docs-control {
					border: 1px solid #d4d4d8;
					border-radius: 0.5rem;
					background: #fff;
					padding: 0.5rem 0.75rem;
					color: #18181b;
					font: 600 0.875rem/1 ui-sans-serif, system-ui, sans-serif;
					text-decoration: none;
					cursor: pointer;
				}
				.docs-control:hover { background: #f4f4f5; }
				.dark .docs-control { border-color: #3f3f46; background: #18181b; color: #fafafa; }
				.dark .docs-control:hover { background: #27272a; }
			</style>
		</head>
		<body>
			<div class="docs-controls">
				<a class="docs-control" href="/">← Home</a>
			</div>
			<div id="app">
				<main style="max-width: 48rem; margin: 5rem auto; padding: 0 1.5rem; font-family: ui-sans-serif, system-ui, sans-serif;">
					<h1>Hypermetrics API Reference</h1>
					<p>Explore Hyperliquid whale alerts, wallet positions, market structure, authentication, and rate limits.</p>
					<p><a href="/openapi.yaml">View the OpenAPI specification</a></p>
				</main>
			</div>
			<script src="https://cdn.jsdelivr.net/npm/@scalar/api-reference@1.64.0"></script>
			<script src="/assets/js/docs.js"></script>
		</body>
	</html>
}
