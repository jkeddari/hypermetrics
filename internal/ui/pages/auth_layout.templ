package pages

templ authBase(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content="Secure access to your Hypermetrics account."/>
			<title>{ title } · Hypermetrics</title>
			<link rel="stylesheet" href="/assets/css/output.css"/>
			<script src="/assets/js/theme.js"></script>
		</head>
		<body class="min-h-screen bg-background text-foreground antialiased">
			<main class="grid min-h-screen lg:grid-cols-[1.05fr_0.95fr]">
				<aside class="relative hidden overflow-hidden bg-zinc-950 p-12 text-zinc-100 lg:flex lg:flex-col lg:justify-between xl:p-16">
					<div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_10%,var(--color-primary),transparent_32%)] opacity-20"></div>
					<div class="relative">
						@authBrand()
					</div>
					<div class="relative max-w-xl">
						<p class="text-sm font-semibold uppercase tracking-[0.25em] text-primary">Hyperliquid intelligence</p>
						<h2 class="mt-5 text-5xl font-bold leading-tight tracking-tight xl:text-6xl">The market moves fast.<br/>Your data should too.</h2>
						<p class="mt-6 max-w-lg text-lg leading-8 text-zinc-400">Live whale activity, wallet positions, and market structure through one focused API.</p>
						<div class="mt-10 grid grid-cols-3 gap-3 text-sm">
							@authProof("Real-time", "signals")
							@authProof("3", "revocable keys")
							@authProof("7 days", "free trial")
						</div>
					</div>
					<p class="relative text-sm text-zinc-500">Built for traders, bot builders, and product teams.</p>
				</aside>
				<section class="relative flex items-center justify-center px-6 py-12 sm:px-12 lg:px-16">
					<div class="absolute right-6 top-6 flex items-center gap-2 sm:right-10 sm:top-8">
						@themeToggle()
						<a href="/" class="text-sm text-muted-foreground transition-colors hover:text-foreground">← Back home</a>
					</div>
					{ children... }
				</section>
			</main>
		</body>
	</html>
}

templ authBrand() {
	<a href="/" class="inline-flex items-center gap-3 font-bold tracking-tight text-current">
		<span class="flex size-9 items-center justify-center rounded-xl bg-primary text-primary-foreground">H</span>
		<span class="text-lg">Hypermetrics</span>
	</a>
}

templ authProof(value string, label string) {
	<div class="rounded-xl border border-white/10 bg-white/5 p-4">
		<p class="font-bold text-white">{ value }</p>
		<p class="mt-1 text-xs text-zinc-500">{ label }</p>
	</div>
}
