package pages

import (
	"github.com/jkeddari/hypermetrics/components/button"
	"github.com/jkeddari/hypermetrics/components/input"
	"github.com/jkeddari/hypermetrics/components/label"
)

templ Register(csrfToken string, email string, planID string, errorMessage string) {
	@authBase("Create account") {
		<div class="w-full max-w-md">
			<div class="mb-10 lg:hidden">
				@authBrand()
			</div>
			<p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Start building</p>
			<h1 class="mt-3 text-4xl font-bold tracking-tight">Create your account.</h1>
			<p class="mt-3 text-muted-foreground">Verify your email, then get your first API key in minutes.</p>
			if errorMessage != "" {
				@formError(errorMessage)
			}
			<form action="/register" method="POST" class="mt-8 space-y-5">
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				if planID != "" {
					<input type="hidden" name="plan" value={ planID }/>
					<div class="flex items-center justify-between rounded-xl border bg-muted/40 px-4 py-3 text-sm">
						<span class="text-muted-foreground">Selected plan</span><strong>{ planName(planID) } · 7-day trial</strong>
					</div>
				}
				<div class="space-y-2">
					@label.Label(label.Props{For: "email"}) {
						Work email 
					}
					@input.Input(input.Props{ID: "email", Name: "email", Type: "email", Value: email, Placeholder: "you@company.com", Required: true, Class: "h-11", Attributes: templ.Attributes{"autocomplete": "email", "aria-invalid": errorMessage != ""}})
				</div>
				<div class="space-y-2">
					@label.Label(label.Props{For: "password"}) {
						Password 
					}
					@input.Input(input.Props{ID: "password", Name: "password", Type: "password", Required: true, Class: "h-11", Attributes: templ.Attributes{"autocomplete": "new-password", "minlength": "12", "maxlength": "72", "aria-invalid": errorMessage != ""}})
					<p class="text-xs text-muted-foreground">12 to 72 characters. A verification link will be sent next.</p>
				</div>
				@button.Button(button.Props{Type: button.TypeSubmit, Class: "h-11 w-full", Size: button.SizeLg}) {
					Create account → 
				}
			</form>
			<p class="mt-8 text-center text-sm text-muted-foreground">Already have an account? <a class="font-semibold text-foreground underline decoration-primary decoration-2 underline-offset-4" href="/login">Sign in</a></p>
		</div>
	}
}
