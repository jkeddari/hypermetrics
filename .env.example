API_PORT=8080
DATABASE_URL=postgres://hypermetrics:hypermetrics@localhost:5432/hypermetrics?sslmode=disable
HM_API_KEYS=replace-me

# The API process runs discovery and wallet refresh workers by default.
HYPERCORE_RUN_COLLECTORS=true
HYPERCORE_REFRESH_RATE=7
HYPERCORE_WHALE_THRESHOLD_USD=1000000
HYPERCORE_REJECTED_CANDIDATE_TTL=12h

# Optional.
HYPERCORE_LEADERBOARD_URL=
HYPERCORE_STATS_LOG_INTERVAL=1m

# Hyperliquid requester-pays S3 ingestion.
S3_INGEST_LOOKBACK=720h
S3_INGEST_POLL_INTERVAL=15m
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

SENTRY_DSN=
